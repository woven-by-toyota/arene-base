######
# Configuration for Github Workflows
#####

# These options take precedence over workspace bazelrc options
#
# See the invoke-arene-run GitHub action and
# https://bazel.build/run/bazelrc#bazelrc-file-locations

common --announce_rc=true
common --show_timestamps=true
common --color=yes

common --remote_upload_local_results=true
common --remote_download_outputs=minimal

test --cache_test_results=yes
# double the default test timeout values
# https://bazel.build/reference/test-encyclopedia#role-test-runner
build --test_timeout=120,600,1800,7200

# quadruple the default test timeout values for asan and tsan configs
build:asan --test_timeout=240,1200,3600,14400
build:tsan --test_timeout=240,1200,3600,14400
