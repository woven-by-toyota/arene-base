load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

filegroup(
    name = "snippets",
    srcs = glob(["*.cpp"]) + [
        "BUILD.bazel",
        "//docs/examples/subpackages:snippets",
    ],
    visibility = ["//docs:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = [
        "atomic_counter_examples.cpp",
        "axis_view_examples.cpp",
        "compiler_support_examples.cpp",
        "constraints_examples.cpp",
        "expect_examples.cpp",
        "inline_container_examples.cpp",
        "ordering_examples.cpp",
        "result_examples.cpp",
        "scope_guard_examples.cpp",
        "type_name_examples.cpp",
        "type_traits_examples.cpp",
        "use_span_examples.cpp",
        "utility_examples.cpp",
    ],
    visibility = ["//docs:__pkg__"],
)

cc_library(
    name = "examples",
    srcs = [":srcs"],
    visibility = [
        "//visibility:private",
    ],
    deps = [
        "//:everything",
    ],
)

cc_binary(
    name = "type_list",
    srcs = [
        "type_list_examples.cpp",
    ],
    deps = [
        "//:type_list",
    ],
)

cc_binary(
    name = "scope_guard_examples",
    srcs = [
        "scope_guard_examples.cpp",
    ],
    visibility = [
        "//visibility:private",
    ],
    deps = [
        "//:everything",
    ],
)

cc_library(
    name = "property_examples",
    testonly = True,
    srcs = ["property_examples.cpp"],
    deps = [
        "//arene/base/compiler_support",
        "//arene/base/testing:property_assertions",
        "//arene/base/testing:property_macros",
    ],
)

filegroup(
    name = "test_srcs",
    srcs = [
        "external_vector_test_examples.cpp",
        "inline_vector_test_examples.cpp",
    ],
)

cc_test(
    name = "test_examples",
    srcs = [":test_srcs"],
    visibility = [
        "//visibility:private",
    ],
    deps = [
        "//:everything",
        "//:inline_container_testing",
        "//testlibs:test_main",
    ],
)

#! [type_traits_build_example]
cc_library(
    name = "type_traits_tutorial",
    srcs = ["type_traits_tutorial.cpp"],
    deps = [
        "@arene-base//:type_traits",
    ],
)
#! [type_traits_build_example]
