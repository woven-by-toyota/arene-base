load("//rules:cc_library_with_variants.bzl", "cc_library_with_variants")

cc_library_with_variants(
    name = "internal",
    hdrs = [
        "optional.hpp",
        "optional_resetter.hpp",
    ],
    visibility = [
        ":__subpackages__",
        "//arene/base:__pkg__",
    ],
    deps = [
        "//arene/base:compare",
        "//arene/base:constraints",
        "//arene/base:contracts",
        "//arene/base:functional",
        "//arene/base:scope_guard",
        "//arene/base:utility",
        "//arene/base/compiler_support",
        "//arene/base/optional/detail",
        "//arene/base/type_manipulation",
        "//arene/base/type_traits:comparison_traits",
        "//arene/base/type_traits:decays_to",
        "//arene/base/type_traits:has_overloaded_address_operator",
        "//arene/base/type_traits:is_instantiation_of",
        "//arene/base/type_traits:is_invocable",
        "//arene/base/type_traits:is_swappable",
        "//arene/base/type_traits:remove_cvref",
    ],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
        "//arene/base/optional/detail:package",
    ] + glob(["*.hpp"]),
    visibility = ["//arene/base:__pkg__"],
)
