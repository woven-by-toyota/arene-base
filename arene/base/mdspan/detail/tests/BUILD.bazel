cc_build_error_test(
    name = "masked_array_domain_size_equals_sentinel_test",
    src = inline_src.cpp("""\
#include "arene/base/detail/dynamic_extent.hpp"
#include "arene/base/mdspan/detail/masked_array.hpp"
#include "arene/base/stdlib_choice/declval.hpp"

// Given a domain size equal to the sentinel, instantiating masked_array must fail.
using codomain_size_type = decltype(
    std::declval<arene::base::mdspan_detail::masked_array<arene::base::dynamic_extent>>().codomain_size()
);

auto main() -> int {}
"""),
    compile_stderr = matcher.contains_extended_regex(
        "error: (static_assert|static assertion) failed.*The domain size must differ from the unmapped-index sentinel",
    ),
    deps = [
        "//arene/base/detail:dynamic_extent",
        "//arene/base/mdspan/detail:masked_array",
        "//arene/base/stdlib_choice:declval",
    ],
)

