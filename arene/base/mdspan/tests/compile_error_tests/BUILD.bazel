cc_build_error_test(
    name = "mdspan_checks_mapping_access_postcondition_test",
    src = inline_src.cpp("""\
#include "arene/base/mdspan/layout.hpp"
#include "arene/base/mdspan/mdspan.hpp"
#include "arene/base/stdlib_choice/cstdint.hpp"
#include "arene/base/stdlib_choice/ignore.hpp"
#include "arene/base/stdlib_choice/numeric_limits.hpp"

struct bad_layout
{
  using base_layout = arene::base::layout_right;

  template <class Extents>
  struct mapping : public base_layout::template mapping<Extents> {
    using base_mapping = typename base_layout::template mapping<Extents>;
    static_assert(std::is_same<std::uint64_t, typename Extents::index_type>::value, "");

   public:
    using base_mapping::base_mapping;

    template <class... OtherIndexArgs>
    constexpr auto operator()(OtherIndexArgs&&...) const noexcept
    {
      // this value does *not* satify the postcondition requirements of a mapping
      return std::uint64_t{std::numeric_limits<std::size_t>::max()} + std::uint64_t{1};
    }
  };
};

static_assert(
  sizeof(std::size_t) < sizeof(std::uint64_t),
  "this test is only intended for 32-bit platforms"
);

auto main() -> int
{
  using extents_type = arene::base::extents<std::uint64_t>;
  static constexpr auto value = int{};
  constexpr auto _ = arene::base::mdspan<int const, extents_type, bad_layout>{&value}();
  std::ignore = _;
}
"""),
    compile_stderr = matcher.contains_basic_regex("error.*contract_violation"),
    target_compatible_with = [
        "@platforms//cpu:cortex-r52",
    ],
    deps = [
        "//arene/base/mdspan",
        "//arene/base/mdspan:layout",
        "//arene/base/stdlib_choice:cstdint",
        "//arene/base/stdlib_choice:ignore",
        "//arene/base/stdlib_choice:numeric_limits",
    ],
)

[
    test_suite(
        name = "{}_slice_mandates_test".format(flavor),
        tests = [
            subtest
            for subtest, _ in [
                (
                    "{}_slice_mandates_{}_test".format(flavor, i),
                    cc_build_error_test(
                        name = "{}_slice_mandates_{}_test".format(flavor, i),
                        src = inline_src.cpp("""\
#include "arene/base/mdspan/slice.hpp"

using slice = arene::base::{flavor}_slice<
  {T1},
  {T2},
  {T3}
>;

auto main() -> int {{
  slice{{}};
}}
                    """.format(
                            T1 = args["T1"],
                            T2 = args["T2"],
                            T3 = args["T3"],
                            flavor = flavor,
                        )),
                        compile_stderr = mandate_error_matcher(
                            diagnostic = "'.+' must be an integer type or model integral-constant-like",
                            requirement = "std::is_integral<.+>::value || is_integral_constant_like_v<.+>",
                        ),
                        deps = ["//arene/base/mdspan:slice"],
                    ),
                )
                for default_args in [
                    {
                        "T1": "std::size_t",
                        "T2": "int",
                        "T3": "std::integral_constant<int, 0>",
                    },
                ]
                for i, args in enumerate([
                    # pointers are not integral-constant-like
                    default_args | {"T1": "int*"},
                    default_args | {"T2": "int*"},
                    default_args | {"T3": "int*"},
                    # references are not integral-constant-like
                    default_args | {"T1": "int&"},
                    default_args | {"T2": "int&"},
                    default_args | {"T3": "int&"},
                    # bool_constant does not satisfy integral-constant-like
                    default_args | {"T1": "std::true_type"},
                ])
            ]
        ],
    )
    for flavor in [
        "extent",
        "range",
    ]
]

