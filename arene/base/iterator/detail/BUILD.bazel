    visibility = ["//:__subpackages__"],
    deps = [
        "//arene/base:constraints",
    ],
)

cc_library_with_variants(
    name = "cond_value_type",
    hdrs = ["cond_value_type.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//arene/base/stdlib_choice:is_object",
        "//arene/base/stdlib_choice:remove_cv",
    ],
)

cc_library_with_variants(
    name = "has_member_element_type",
    hdrs = ["has_member_element_type.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//arene/base:constraints",
    ],
)

cc_library_with_variants(
    name = "has_member_value_type",
    hdrs = ["has_member_value_type.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//arene/base:constraints",
    ],
)

cc_library_with_variants(
    name = "is_dereferenceable",
    hdrs = ["is_dereferenceable.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":can_reference",
        "//arene/base:constraints",
        "//arene/base/stdlib_choice:declval",
    ],
)

cc_library_with_variants(
    name = "iter_concept",
    hdrs = ["iter_concept.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//arene/base:constraints",
        "//arene/base/stdlib_choice:iterator_traits",
