filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
    ] + glob(["*.hpp"]),
    visibility = ["//arene/base/iterator:__pkg__"],
)

cc_library_with_variants(
    name = "std_reverse_iterator",
