cc_build_error_test(
    name = "scaled_accessor_scaling_factor_mandate_test",
    src = inline_src.cpp("""\
#include "arene/base/linalg/scaled_accessor.hpp"
#include "arene/base/mdspan/default_accessor.hpp"
#include "testlibs/utilities/configurable_value.hpp"

// A non-assignable type is not semiregular and therefore is not a linalg scalar.
using not_assignable = testing::configurable_value<
    int,
    testing::throws_on::nothing,
    testing::disable::copy_assign | testing::disable::move_assign
>;

auto main() -> int {{
  arene::base::linalg::scaled_accessor<not_assignable, arene::base::default_accessor<not_assignable>> acc;
  return acc.scaling_factor().value;
}}
"""),
    compile_stderr = mandate_error_matcher(
        diagnostic = "ScalingFactor must be a linalg scalar",
        requirement = "arene::base::linalg::is_scalar_v<.+>",
    ),
    deps = [
        "//arene/base/linalg:scaled_accessor",
        "//arene/base/mdspan:default_accessor",
        "//testlibs/utilities:configurable_value",
    ],
)

cc_build_error_test(
    name = "scaled_accessor_accessor_policy_mandate_test",
    src = inline_src.cpp("""\
#include "arene/base/linalg/scaled_accessor.hpp"
#include "arene/base/mdspan/default_accessor.hpp"
#include "arene/base/stdlib_choice/cstddef.hpp"

// This is almost, but not quite, a valid mdspan accessor policy.
class malformed_accessor {
 public:
  using element_type = int;
  using reference = int&;
  using data_handle_type = int*;
  using offset_policy = malformed_accessor;

  // This function should return "reference" but returns "element_type" instead.
  constexpr auto access(data_handle_type handle, std::size_t index) const noexcept -> element_type {
    return handle[index];
  }

  constexpr auto offset(data_handle_type handle, std::size_t index) const noexcept -> data_handle_type {
    return handle + index;
  }
};

auto main() -> int {{
  arene::base::linalg::scaled_accessor<int, malformed_accessor> acc;
  return acc.scaling_factor();
}}
"""),
    compile_stderr = mandate_error_matcher(
        diagnostic = "NestedAccessor must be a valid accessor policy",
        requirement = "arene::base::is_accessor_policy_v<.+>",
    ),
    deps = [
        "//arene/base/linalg:scaled_accessor",
        "//arene/base/mdspan:default_accessor",
        "//arene/base/stdlib_choice:cstddef",
    ],
)
