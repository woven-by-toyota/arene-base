load(
    "//rules:cc_build_error.bzl",
    "cc_build_error_test",
    "inline_src",
    "mandate_error_matcher",
)

cc_build_error_test(
    name = "scaled_accessor_element_type_mandate_test",
    src = inline_src.cpp("""\
#include "arene/base/linalg/scaled_accessor.hpp"
#include "arene/base/mdspan/default_accessor.hpp"

// Returning a reference from multiplication causes element_type to become a reference (which is illegal).
struct evil_int {
  int value;

  friend evil_int& operator*(evil_int left, evil_int right) {
    static evil_int result;
    result.value = left.value * right.value;
    return result;
  }
};

auto main() -> int {{
  arene::base::linalg::scaled_accessor<evil_int, arene::base::default_accessor<evil_int>> acc;
  return acc.scaling_factor().value;
}}
"""),
    compile_stderr = mandate_error_matcher(
        diagnostic = "Element type must not be a reference",
        requirement = "!std::is_reference<.+>::value",
    ),
    deps = [
        "//arene/base/linalg:scaled_accessor",
        "//arene/base/mdspan:default_accessor",
    ],
)

