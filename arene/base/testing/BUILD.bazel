load("//rules:cc_library_with_variants.bzl", "cc_library_with_variants")

# test library extensions without main
cc_library_with_variants(
    name = "gtest",
    hdrs = ["gtest.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//arene/base/testing/gtest:gtest_internal",
    ],
)

# test library extensions with main (this is only defined for public export)
cc_library_with_variants(
    name = "gtest_main_public",
    hdrs = ["gtest.hpp"],
    visibility = ["//:__pkg__"],
    deps = [
        ":gtest",
    ] + select({
        # exclude transitive @com_google_googletest dependency when exporting for cmake
        # we shall not bundle @com_google_googletest
        "//configs:export_cmake": [],
        "//conditions:default": ["//testlibs:test_main"],
    }),
)

