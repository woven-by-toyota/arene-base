load("@rules_cc//cc:defs.bzl", "cc_library")

exports_files(
    ["string_view.cpp"],
    visibility = [
        "//arene/base/strings/detail:__pkg__",
    ],
)

cc_library(
    name = "null_terminated_string_view",
    hdrs = [
        "string_view_ostream_mixin.hpp",
    ],
    include_prefix = "arene/base/strings/detail",
    visibility = [
        "//arene/base/strings/detail:__pkg__",
    ],
)

cc_library(
    name = "string_view",
    hdrs = [
        "string_view_ostream_mixin.hpp",
    ],
    include_prefix = "arene/base/strings/detail",
    visibility = [
        "//arene/base/strings/detail:__pkg__",
    ],
)

cc_library(
    name = "inline_string",
    hdrs = [
        "inline_string_std_string_mixin.hpp",
    ],
    include_prefix = "arene/base/strings/detail",
    visibility = [
        "//arene/base/strings/detail:__pkg__",
    ],
    deps = [
        "//arene/base:compare",
        "//arene/base/compiler_support",
    ],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
    ] + glob([
        "*.cpp",
        "*.hpp",
    ]),
    visibility = [
        "//arene/base/strings/detail:__pkg__",
    ],
)
