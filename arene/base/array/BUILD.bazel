load("//rules:cc_library_with_variants.bzl", "cc_library_with_variants")

cc_library_with_variants(
    name = "array",
    srcs = select({
        "//configs:exceptions_enabled": ["array_exceptions_enabled.cpp"],
        "//configs:exceptions_disabled": [],
    }),
    hdrs = [
        "array.hpp",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//arene/base:constraints",
        "//arene/base:contracts",
        "//arene/base/algorithm:equal",
        "//arene/base/algorithm:lexicographical_compare",
        "//arene/base/compare:compare_three_way",
        "//arene/base/compare:operators",
        "//arene/base/compare:strong_ordering",
        "//arene/base/compiler_support:attributes",
        "//arene/base/detail:exceptions",
        "//arene/base/detail:wrapped_iterator",
        "//arene/base/functional:construct",
        "//arene/base/functional:identity",
        "//arene/base/iterator:reverse_iterator",
        "//arene/base/stdlib_choice:cstddef",
        "//arene/base/stdlib_choice:enable_if",
        "//arene/base/stdlib_choice:is_assignable",
        "//arene/base/stdlib_choice:is_same",
        "//arene/base/stdlib_choice:numeric_limits",
        "//arene/base/stdlib_choice:tuple_element",
        "//arene/base/stdlib_choice:tuple_size",
        "//arene/base/type_traits:comparison_traits",
        "//arene/base/type_traits:is_swappable",
        "//arene/base/type_traits:remove_cvref",
        "//arene/base/utility:swap",
    ] + select({
        "//configs:exceptions_enabled": [
            "//arene/base/stdlib_choice:stdexcept",
        ],
        "//configs:exceptions_disabled": [],
    }),
)

cc_library_with_variants(
    name = "to_array",
    hdrs = ["to_array.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":array",
        "//arene/base:constraints",
        "//arene/base/compiler_support:cpp14_inline",
        "//arene/base/functional:construct",
        "//arene/base/functional:identity",
        "//arene/base/stdlib_choice:conditional",
        "//arene/base/stdlib_choice:cstddef",
        "//arene/base/stdlib_choice:enable_if",
        "//arene/base/stdlib_choice:integer_sequence",
        "//arene/base/stdlib_choice:is_array",
        "//arene/base/stdlib_choice:is_constructible",
        "//arene/base/stdlib_choice:is_move_constructible",
        "//arene/base/stdlib_choice:is_object",
        "//arene/base/stdlib_choice:remove_cv",
        "//arene/base/stdlib_choice:remove_reference",
        "//arene/base/type_traits:is_invocable",
        "//arene/base/type_traits:remove_cvref",
    ],
)

cc_library_with_variants(
    name = "internal",
    visibility = ["//arene/base:__pkg__"],
    deps = [
        ":array",
        ":to_array",
    ],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
    ] + glob([
        "*.cpp",
        "*.hpp",
    ]),
    visibility = ["//arene/base:__pkg__"],
)
