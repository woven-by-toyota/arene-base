load("@rules_cc//cc:defs.bzl", "cc_library", _cc_test = "cc_test")
load("//rules:cc_test.bzl", "cc_test", "cc_test_with_variants")
load(
    "//rules:transitions.bzl",
    "transition_use_exceptions",
    "transition_use_toolchain_stdlib",
)

package(default_visibility = ["//tools:__subpackages__"])

[
    (
        cc_library(
            name = "array_test_deps_{}".format(flavor),
            testonly = True,
            tags = ["manual"],
            deps = [
                "//arene/base:span",
                "//arene/base/array",
                "//arene/base/compiler_support",
                "//arene/base/detail:exceptions",
                "//arene/base/integer_sequences:sequential_values",
                "//arene/base/iterator:next",
                "//arene/base/iterator:reverse_iterator",
                "//arene/base/stdlib_choice:cstddef",
                "//arene/base/stdlib_choice:declval",
                "//arene/base/stdlib_choice:ignore",
                "//arene/base/stdlib_choice:is_default_constructible",
                "//arene/base/stdlib_choice:iterator_tags",
                "//arene/base/stdlib_choice:iterator_traits",
                "//arene/base/stdlib_choice:stdexcept",
                "//arene/base/testing:gtest",
                "//arene/base/type_list",
                "//arene/base/type_list:concat",
                "//arene/base/type_traits:comparison_traits",
                "//arene/base/type_traits:is_swappable",
                "//arene/base/type_traits:iterator_category_traits",
                "//testlibs:test_main",
                "//testlibs/utilities:configurable_value",
                "//testlibs/utilities:has_broken_less_than",
            ],
        ),
        transition_use_exceptions(
            name = "array_test_deps_tr1_{}".format(flavor),
            testonly = True,
            src = ":array_test_deps_{}".format(flavor),
            tags = ["manual"],
            value = use_exceptions,
        ),
        transition_use_toolchain_stdlib(
            name = "array_test_deps_tr2_{}".format(flavor),
            testonly = True,
            src = ":array_test_deps_tr1_{}".format(flavor),
            tags = ["manual"],
            value = use_toolchain_stdlib,
        ),
        # we need to explicitly set incompatibility so we use the actual
        # 'cc_test' from '@rules_cc'
        _cc_test(
            name = "array_{}_test".format(flavor),
            srcs = ["array_test.cpp"],
            deps = [
                ":array_test_deps_tr2_{}".format(flavor),
            ] + extra_deps,
        ),
    )
    for use_exceptions, use_toolchain_stdlib, flavor, extra_deps in [
        (
            True,
            True,
            "exc_stdlib",
            [
                "//configs:incompatible_with_exceptions_disabled",
                "//configs:incompatible_with_toolchain_stdlib_disabled",
            ],
        ),
        (
            True,
            False,
            "exc_nostdlib",
            [
                "//configs:incompatible_with_exceptions_disabled",
            ],
        ),
        (
            False,
            True,
            "noexc_stdlib",
            [
                "//configs:incompatible_with_toolchain_stdlib_disabled",
            ],
        ),
        (False, False, "noexc_nostdlib", []),
    ]
]

cc_test(
    name = "array_at_test",
    srcs = ["array_at_test.cpp"],
    deps = [
        "//arene/base/array",
        "//arene/base/compiler_support",
        "//arene/base/detail:exceptions",
        "//arene/base/stdlib_choice:cstddef",
        "//arene/base/stdlib_choice:stdexcept",
        "//configs:incompatible_with_exceptions_disabled",
        "//testlibs:test_main",
    ],
)

cc_test_with_variants(
    name = "array_death_test",
    srcs = ["array_death_test.cpp"],
    deps = [
        "//arene/base/array",
        "//arene/base/compiler_support",
        "//testlibs:death_test_support",
        "//testlibs:test_main",
    ],
)

cc_test_with_variants(
    name = "to_array_test",
    srcs = ["to_array_test.cpp"],
    deps = [
        "//arene/base/array:to_array",
        "//arene/base/stdlib_choice:begin",
        "//arene/base/stdlib_choice:cstddef",
        "//arene/base/stdlib_choice:cstdint",
        "//arene/base/stdlib_choice:end",
        "//arene/base/stdlib_choice:exchange",
        "//arene/base/testing:gtest",
        "//arene/base/type_traits:is_invocable",
        "//testlibs:test_main",
        "//testlibs/utilities:configurable_value",
    ],
)
