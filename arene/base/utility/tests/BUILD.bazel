cc_build_error_test(
    name = "forward_like_ill_formed_with_non_referenceable_type_test",
    src = inline_src.cpp(
        """\
#include "arene/base/utility/forward_like.hpp"

auto main() -> int
{
  arene::base::forward_like<void>(0);
}
""",
    ),
    compile_stderr = matcher.contains_extended_regex(
        "error: (cannot form a reference|forming reference)",
    ),
    deps = [
        "//arene/base/utility:forward_like",
    ],
)
