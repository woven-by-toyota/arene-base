load("@rules_cc//cc:defs.bzl", "cc_library")
load("//rules:cc_test.bzl", "cc_test_with_variants")

package(default_visibility = ["//tools:__subpackages__"])

exports_files(
    glob([
        "*.hpp",
        "*.cpp",
    ]),
    visibility = ["//:__subpackages__"],
)

cc_test_with_variants(
    name = "dynamic_extent_test",
    srcs = ["dynamic_extent_test.cpp"],
    deps = [
        "//arene/base/detail:dynamic_extent",
        "//arene/base/stdlib_choice:cstdint",
        "//arene/base/stdlib_choice:numeric_limits",
        "//arene/base/testing:gtest",
        "//testlibs:test_main",
    ],
)

cc_library(
    name = "index_permutation_range_test_types",
    testonly = True,
    hdrs = ["index_permutation_range_test_types.hpp"],
    deps = [
        "//arene/base:array",
        "//arene/base/stdlib_choice:cstddef",
        "//testlibs:test_library",
    ],
)

