cc_build_error_test(
    name = "abs_cpo_no_abs_defined_test",
    src = inline_src.cpp("""\
#include "arene/base/math/abs_cpo.hpp"

struct type_without_abs{};

auto main() -> int
{
  arene::base::math::abs(type_without_abs{});
}
"""),
    compile_stderr = matcher.contains_basic_regex(
        select({
            "//conditions:default": "error: no matching function for call to object of type",
            "//configs/compiler:gcc_or_qcc": "error: no match for call to '(const arene::base::math::abs_detail::abs_impl) (type_without_abs)'",
        }),
    ),
    deps = [
        "//arene/base/math:abs_cpo",
    ],
)

