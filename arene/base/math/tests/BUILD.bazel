[
    cc_build_error_test(
        name = "float_property_non_bool_adl_overload_{}_test".format(predicate),
        src = inline_src.cpp("""\
#include "arene/base/math/float_properties.hpp"

namespace user_types {{

struct int_returning {{
  friend constexpr auto {predicate}(int_returning) noexcept -> int {{ return 1; }}
}};

}}  // namespace user_types

auto main() -> int
{{
  (void)arene::base::{predicate}(user_types::int_returning{{}});
}}
""".format(predicate = predicate)),
        compile_stderr = matcher.has_substr(
            "ADL overload of {} must return bool".format(predicate),
        ),
        deps = [
            "//arene/base/math:float_properties",
        ],
    )
    for predicate in [
        "isnan",
        "isinf",
        "isfinite",
        "isnormal",
    ]
]

