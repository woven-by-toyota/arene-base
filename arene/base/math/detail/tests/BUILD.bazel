load("//rules:cc_test.bzl", "cc_test_with_variants")

package(default_visibility = ["//tools:__subpackages__"])

exports_files(
    glob(["*.cpp"]),
    visibility = ["//:__subpackages__"],
)

cc_test_with_variants(
    name = "abs_float_test_builtin",
    srcs = ["abs_float_test.cpp"],
    defines = ["ARENE_BASE_MATH_DETAIL_USE_BUILTIN_ABS_FLOAT"],
    deps = [
        "//arene/base/compiler_support",
        "//arene/base/math:internal",
        "//arene/base/testing:gtest",
        "//testlibs:test_main",
    ],
)

cc_test_with_variants(
    name = "abs_float_test_custom",
    srcs = ["abs_float_test.cpp"],
    deps = [
        "//arene/base/compiler_support",
        "//arene/base/math:internal",
        "//arene/base/testing:gtest",
        "//testlibs:test_main",
    ],
)

cc_test_with_variants(
    name = "less_nan_highest_test",
    srcs = ["less_nan_highest_test.cpp"],
    deps = [
        "//arene/base/compiler_support:attributes",
        "//arene/base/math:float_properties",
        "//arene/base/math/detail:less_nan_highest",
        "//arene/base/stdlib_choice:ignore",
        "//arene/base/stdlib_choice:less",
        "//arene/base/stdlib_choice:numeric_limits",
        "//arene/base/testing:bitwise_uniform_distribution",
        "//arene/base/testing:gtest",
        "//arene/base/testing:nan_rejecting_distribution",
        "//arene/base/testing:property_assertions",
        "//arene/base/testing:property_macros",
        "//arene/base/type_list:concat_unique",
        "//testlibs:test_main",
        "//testlibs/utilities:common_test_types",
        "//testlibs/utilities:configurable_value",
    ],
)
