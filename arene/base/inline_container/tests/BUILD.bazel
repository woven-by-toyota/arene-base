# Storing an invocable whose alignment requirement exceeds the buffer's alignment would place it at an under-aligned
# address, so it is rejected by a `static_assert`. These tests assert the rejection is a build error rather than
# silently-undefined behaviour. The buffer size is set to the invocable's size so that the size constraint is satisfied
# and only the alignment check can be doing the rejecting.
[
    cc_build_error_test(
        name = "over_aligned_invocable_cannot_be_{}_test".format(param["name"]),
        src = inline_src.cpp("""\
#include "arene/base/inline_container/function.hpp"

struct alignas(2U * arene::base::default_inline_function_alignment) over_aligned_callable {{
  auto operator()() const noexcept -> int {{ return 0; }}
}};

auto main() -> int {{
  using function_type = arene::base::inline_function<{signature}, sizeof(over_aligned_callable)>;
  {body}
  static_cast<void>(func);
}}
""".format(
            body = param["body"],
            signature = param["signature"],
        )),
        compile_stderr = matcher.has_substr("requires stricter alignment than the inline_function it is stored in"),
        deps = ["//arene/base/inline_container:inline_function"],
    )
    for param in [
        {
            "name": "constructed",
            "signature": "auto () -> int",
            "body": "function_type func{over_aligned_callable{}};",
        },
        {
            "name": "assigned",
            "signature": "auto () -> int",
            "body": "function_type func{}; func = over_aligned_callable{};",
        },
        {
            "name": "constructed_when_const_qualified",
            "signature": "auto () const -> int",
            "body": "function_type func{over_aligned_callable{}};",
        },
        {
            "name": "assigned_when_const_qualified",
            "signature": "auto () const -> int",
            "body": "function_type func{}; func = over_aligned_callable{};",
        },
    ]
]

