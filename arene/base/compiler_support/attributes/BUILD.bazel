load("//rules:cc_library_with_variants.bzl", "cc_library_with_variants")

cc_library_with_variants(
    name = "has_attribute",
    hdrs = ["has_attribute.hpp"],
    visibility = ["//arene/base:__subpackages__"],
)

cc_library_with_variants(
    name = "deprecated",
    hdrs = ["deprecated.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [":has_attribute"],
)

cc_library_with_variants(
    name = "may_alias",
    hdrs = ["may_alias.hpp"],
    visibility = ["//arene/base:__subpackages__"],
)

cc_library_with_variants(
    name = "maybe_unused",
    hdrs = ["maybe_unused.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [":has_attribute"],
)

cc_library_with_variants(
    name = "nodiscard",
    hdrs = ["nodiscard.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [":has_attribute"],
)

cc_library_with_variants(
    name = "noreturn",
    hdrs = ["noreturn.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [":has_attribute"],
)

cc_library_with_variants(
    name = "internal",
    visibility = ["//arene/base/compiler_support:__pkg__"],
    deps = [
        ":deprecated",
        ":has_attribute",
        ":may_alias",
        ":maybe_unused",
        ":nodiscard",
        ":noreturn",
    ],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
    ] + glob(["*.hpp"]),
    visibility = ["//arene/base/compiler_support:__pkg__"],
)
