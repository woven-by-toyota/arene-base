load("//bazel_lib:if_host_platform.bzl", "if_host_platform")
load("//rules:cc_library_with_variants.bzl", "cc_library_with_variants")

cc_library_with_variants(
    name = "attributes",
    hdrs = ["attributes.hpp"],
    visibility = ["//:__subpackages__"],
    deps = ["//arene/base/compiler_support/attributes:internal"],
)

cc_library_with_variants(
    name = "cpp14_inline",
    hdrs = ["cpp14_inline.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":attributes",
        ":platform_queries",
        ":preprocessor",
    ],
)

cc_library_with_variants(
    name = "hardware_queries",
    hdrs = ["hardware_queries.hpp"],
    deps = [
        ":attributes",
        "//arene/base/compiler_support/hardware_queries:internal",
        "//arene/base/stdlib_choice:cstddef",
    ],
)

cc_library_with_variants(
    name = "platform_queries",
    hdrs = ["platform_queries.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":preprocessor",
        "//arene/base/compiler_support/platform_queries:internal",
        "//arene/base/stdlib_choice:cstddef",
    ],
)

cc_library_with_variants(
    name = "preprocessor",
    hdrs = ["preprocessor.hpp"],
    visibility = ["//:__subpackages__"],
    deps = ["//arene/base/compiler_support/preprocessor:internal"],
)

cc_library_with_variants(
    name = "asan_annotations",
    hdrs = ["asan_annotations.hpp"],
    defines = select({
        "//conditions:default": [],
        "//configs:exceptions_disabled_by_flag": ["ARENE_EXCEPTIONS_ENABLED=0"],
    }),
    # <sanitizer/asan_interface.h> is not available for IWYU on macOS
    tags = if_host_platform.is_macos(["no-arene-iwyu"]),
    visibility = ["//arene/base:__subpackages__"],
    deps = [
        ":platform_queries",
        ":preprocessor",
        "//arene/base/compiler_support/detail:asan_annotations_disabled",
        "//arene/base/compiler_support/detail:asan_annotations_enabled",
    ],
)

cc_library_with_variants(
    name = "builtin_types",
    hdrs = ["builtin_types.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [
        "//arene/base/stdlib_choice:cstddef",
        "//arene/base/stdlib_choice:cstdint",
    ],
)

cc_library_with_variants(
    name = "expect",
    hdrs = ["expect.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [
        ":platform_queries",
        "//arene/base/compiler_support/detail:expect_builtin",
        "//arene/base/compiler_support/detail:expect_plain",
        "//arene/base/stdlib_choice:forward",
    ],
)

cc_library_with_variants(
    name = "integer_types",
    hdrs = ["integer_types.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = ["//arene/base/stdlib_choice:cstdint"],
)

cc_library_with_variants(
    name = "is_possibly_constant_evaluated",
    hdrs = ["is_possibly_constant_evaluated.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [
        ":platform_queries",
        ":preprocessor",
    ],
)

cc_library_with_variants(
    name = "thread_safety_annotations",
    hdrs = ["thread_safety_annotations.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [
        ":platform_queries",
        ":preprocessor",
        "//arene/base/compiler_support/detail:thread_safety_annotations_disabled",
        "//arene/base/compiler_support/detail:thread_safety_annotations_enabled",
    ],
)

cc_library_with_variants(
    name = "version",
    hdrs = ["version.hpp"],
    visibility = ["//arene/base:__subpackages__"],
    deps = [
        "//arene/base/detail:raw_c_string",
        "//arene/base/stdlib_choice:cstdint",
    ],
)

cc_library_with_variants(
    name = "diagnostics",
    hdrs = ["diagnostics.hpp"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":platform_queries",
        ":preprocessor",
    ],
)

cc_library_with_variants(
    name = "internal",
    visibility = ["//:__subpackages__"],
    deps = [
        ":asan_annotations",
        ":attributes",
        ":builtin_types",
        ":cpp14_inline",
        ":expect",
        ":hardware_queries",
        ":integer_types",
        ":is_possibly_constant_evaluated",
        ":platform_queries",
        ":preprocessor",
        ":thread_safety_annotations",
        ":version",
    ],
)

cc_library_with_variants(
    name = "compiler_support",
    visibility = ["//:__subpackages__"],
    deps = [
        ":diagnostics",
        ":internal",
    ],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
        "//arene/base/compiler_support/attributes:package",
        "//arene/base/compiler_support/detail:package",
        "//arene/base/compiler_support/hardware_queries:package",
        "//arene/base/compiler_support/platform_queries:package",
        "//arene/base/compiler_support/preprocessor:package",
    ] + glob(["*.hpp"]),
    visibility = ["//arene/base:__pkg__"],
)
