load("//bazel_lib:if_host_platform.bzl", "if_host_platform")
load("//rules:cc_library_with_variants.bzl", "cc_library_with_variants")

cc_library_with_variants(
    name = "asan_annotations_disabled",
    hdrs = ["asan_annotations_disabled.hpp"],
    visibility = ["//arene/base/compiler_support:__pkg__"],
)

cc_library_with_variants(
    name = "asan_annotations_enabled",
    hdrs = ["asan_annotations_enabled.hpp"],
    tags = if_host_platform.is_macos(["no-arene-iwyu"]),
    visibility = ["//arene/base/compiler_support:__pkg__"],
)

cc_library_with_variants(
    name = "expect_builtin",
    hdrs = ["expect_builtin.hpp"],
    visibility = ["//arene/base/compiler_support:__pkg__"],
)

cc_library_with_variants(
    name = "expect_plain",
    hdrs = ["expect_plain.hpp"],
    visibility = ["//arene/base/compiler_support:__pkg__"],
)

cc_library_with_variants(
    name = "thread_safety_annotations_disabled",
    hdrs = ["thread_safety_annotations_disabled.hpp"],
    visibility = ["//arene/base/compiler_support:__pkg__"],
)

cc_library_with_variants(
    name = "thread_safety_annotations_enabled",
    hdrs = ["thread_safety_annotations_enabled.hpp"],
    visibility = ["//arene/base/compiler_support:__pkg__"],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
    ] + glob(["*.hpp"]),
    visibility = ["//arene/base/compiler_support:__pkg__"],
)
