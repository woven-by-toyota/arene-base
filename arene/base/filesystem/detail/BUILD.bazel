load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "detail",
    srcs = ["encode_counter.cpp"],
    hdrs = ["encode_counter.hpp"],
    visibility = ["//arene/base/filesystem:__subpackages__"],
    deps = [
        "//arene/base:math",
        "//arene/base:span",
        "//arene/base:string_view",
        "//configs:incompatible_with_toolchain_stdlib_disabled",
    ],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
    ] + glob([
        "*.cpp",
        "*.hpp",
    ]),
    visibility = ["//arene/base/filesystem:__pkg__"],
)
