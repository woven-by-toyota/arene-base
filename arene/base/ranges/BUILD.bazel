        "//arene/base:constraints",
        "//arene/base/compiler_support:attributes",
        "//arene/base/compiler_support:cpp14_inline",
        "//arene/base/ranges/detail:is_input_or_output_iterator",
        "//arene/base/ranges/detail:is_sentinel_for",
        "//arene/base/stdlib_choice:cstddef",
        "//arene/base/stdlib_choice:declval",
        "//arene/base/stdlib_choice:enable_if",
        "//arene/base/stdlib_choice:extent",
        "//arene/base/stdlib_choice:forward",
        "//arene/base/stdlib_choice:is_array",
        "//arene/base/stdlib_choice:is_constructible",
        "//arene/base/stdlib_choice:is_lvalue_reference",
        "//arene/base/stdlib_choice:is_same",
        "//arene/base/stdlib_choice:remove_cv",
        "//arene/base/stdlib_choice:remove_extent",
        "//arene/base/stdlib_choice:remove_reference",
        "//arene/base/stdlib_choice:tuple",
        "//arene/base/stdlib_choice:tuple_size",
        "//arene/base/type_traits:priority_tag",
        "//arene/base/type_traits:remove_cvref",
    ],
)

