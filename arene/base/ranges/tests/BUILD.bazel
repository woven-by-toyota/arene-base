load("//rules:cc_library_with_variants.bzl", "cc_library_with_variants")
load("//rules:cc_test.bzl", "cc_test_with_variants")

package(default_visibility = ["//tools:__subpackages__"])

exports_files(
    glob([
        "*.cpp",
        "*.hpp",
    ]),
    visibility = ["//:__subpackages__"],
)

cc_library_with_variants(
    name = "ranges_test_helpers",
    testonly = True,
    hdrs = ["ranges_test_helpers.hpp"],
    deps = [
        "//arene/base:array",
        "//arene/base/compiler_support",
        "//arene/base/inline_container:vector",
        "//arene/base/ranges:enable_borrowed_range",
        "//arene/base/stdlib_choice:add_const",
        "//arene/base/stdlib_choice:add_lvalue_reference",
        "//arene/base/stdlib_choice:add_rvalue_reference",
        "//arene/base/stdlib_choice:integral_constant",
        "//arene/base/testing:gtest",
        "//arene/base/type_list:apply_each",
        "//arene/base/type_list:concat",
        "//arene/base/type_list:remove_duplicates",
    ],
)

cc_test_with_variants(
    name = "borrowed_iterator_test",
    srcs = ["borrowed_iterator_test.cpp"],
    deps = [
        ":ranges_test_helpers",
        "//arene/base/ranges:borrowed_iterator",
        "//arene/base/testing:gtest",
