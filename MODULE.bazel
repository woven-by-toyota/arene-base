module(
    name = "arene-base",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.14")

bazel_dep(name = "buildifier_prebuilt", version = "8.0.1", dev_dependency = True)
bazel_dep(name = "google_benchmark", version = "1.9.4", dev_dependency = True)
bazel_dep(name = "rules_doxygen", version = "2.6.4", dev_dependency = True)
bazel_dep(name = "rules_rust", version = "0.69.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)


# Patch rules_rust to work with the PATH set by our Nix shell. The release
# artifact is used instead of the source tag archive since only the former
# contains the generated urls.bzl listing prebuilt cargo-bazel binaries.
[
    archive_override(
        module_name = "rules_rust",
        integrity = "sha256-u8dkwlLQYSgbI1knek1GSA4tz69yr8HObgCtpYzL/Uw=",
        patch_strip = 1,
        patches = [
            # https://github.com/bazelbuild/rules_rust/issues/2177
            "//:patches/rules_rust/0001-enable-default-shell-env-with-rustc.patch",
        ],
        urls = [
            "https://github.com/bazelbuild/rules_rust/releases/download/{0}/rules_rust-{0}.tar.gz".format(version),
        ],
    )
    for version in ["0.69.0"]
]

rust = use_extension(
    "@rules_rust//rust:extensions.bzl",
    "rust",
    dev_dependency = True,
)
rust.toolchain(versions = ["1.94.1"])
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)

crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    dev_dependency = True,
)
crate.spec(
    package = "libc",
    version = "0.2.185",
)
crate.spec(
    package = "rand_xoshiro",
    version = "0.8.0",
)
crate.from_specs(name = "crates")
use_repo(crate, "crates")

doxygen_extension = use_extension(
    "@rules_doxygen//:extensions.bzl",
    "doxygen_extension",
    dev_dependency = True,
)

use_repo(doxygen_extension, rules_doxygen_ext = "doxygen")


bazel_dep(name = "googletest", version = "1.14.0", repo_name = "com_google_googletest")
bazel_dep(name = "rules_build_error", version = "0.8.6", dev_dependency = True)
