load("@bazel_skylib//lib:selects.bzl", "selects")
load("//rules:cc_library_with_variants.bzl", "cc_library_with_variants")

selects.config_setting_group(
    name = "death_tests_supported",
    match_any = [
        "//testlibs:death_tests_supported",
    ],
    visibility = [":__subpackages__"],
)


cc_library_with_variants(
    name = "assertion_strings",
    hdrs = ["assertion_strings.hpp"],
    visibility = [
        ":__subpackages__",
        "//arene/base/testing:__pkg__",
    ],
)

cc_library_with_variants(
    name = "cstring",
    hdrs = ["cstring.hpp"],
    visibility = [":__subpackages__"],
)

cc_library_with_variants(
    name = "line_number",
    hdrs = ["line_number.hpp"],
    visibility = [":__subpackages__"],
)

cc_library_with_variants(
    name = "source_location",
    hdrs = ["source_location.hpp"],
    visibility = [
        ":__subpackages__",
        "//arene/base/testing:__pkg__",
    ],
    deps = [
        ":line_number",
    ],
)

cc_library_with_variants(
    name = "test_context",
    hdrs = ["test_context.hpp"],
    visibility = [":__subpackages__"],
    deps = [
        ":line_number",
    ],
)

cc_library_with_variants(
    name = "type_name",
    hdrs = ["type_name.hpp"],
    visibility = [":__subpackages__"],
    deps = [":cstring"],
)

cc_library_with_variants(
    name = "libc",
    srcs = select({
        "//configs/compiler:arm_clang": [
            "libc_armv8-r/libc.cpp",
        ],
        "//conditions:default": [
            "libc_default/libc.cpp",
        ],
    }),
    hdrs = ["libc.hpp"],
    visibility = [":__subpackages__"],
    deps = select({
        "//conditions:default": [
        ],
    }),
)

cc_library_with_variants(
    name = "minitest_library",
    srcs = [
        "death_tests.hpp",
        "matcher.hpp",
        "minitest_library.cpp",
        "minitest_output.cpp",
        "minitest_output.hpp",
        "utility.hpp",
    ],
    hdrs = [
        "minitest.hpp",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":assertion_strings",
        ":cstring",
        ":libc",
        ":line_number",
        ":source_location",
        ":test_context",
        ":type_name",
        "//testlibs/minitest/detail:death_tests",
    ],
)

cc_library_with_variants(
    name = "minitest_main",
    srcs = [
        "minitest_main.cpp",
    ],
    hdrs = [
        "minitest.hpp",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":minitest_library",
    ],
    alwayslink = True,
)

cc_library_with_variants(
    name = "public",
    hdrs = [
        "minitest.hpp",
    ],
    include_prefix = "minitest/",
    visibility = ["//:__pkg__"],
    deps = [
        ":minitest_main",
    ],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
        "//testlibs/minitest/detail:package",
    ] + glob([
        "*.cpp",
        "*.hpp",
        "libc_armv8-r/*.cpp",
        "libc_default/*.cpp",
    ]) + glob(
        ["woven-private/libc_none_cortex-r52/*.cpp"],
        allow_empty = True,
    ),
    visibility = ["//testlibs:__pkg__"],
)
