load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "death_tests",
    srcs = select({
        "//configs:posix": ["death_tests_posix.cpp"],
        "//conditions:default": [],
    }),
    hdrs = [
        "death_tests_disabled.hpp",
        "death_tests_enabled.hpp",
    ],
    defines = select({
        "//testlibs/minitest:death_tests_supported": [
            "MINITEST_DEATH_TESTS_ENABLED=1",
        ],
        "//conditions:default": [],
    }),
    include_prefix = "testlibs/minitest",
    visibility = ["//testlibs/minitest:__pkg__"],
    deps = [
        "//testlibs/minitest:assertion_strings",
        "//testlibs/minitest:cstring",
        "//testlibs/minitest:libc",
        "//testlibs/minitest:source_location",
    ],
)

filegroup(
    name = "package",
    srcs = [
        "BUILD.bazel",
    ] + glob([
        "*.cpp",
        "*.hpp",
    ]),
    visibility = ["//testlibs/minitest:__pkg__"],
)
